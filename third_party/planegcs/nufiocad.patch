-using Graph = boost::adjacency_list<boost::vecS, boost::vecS, boost::undirectedS>;
+// NufioCAD: sustituye boost::adjacency_list + boost::connected_components por
+// un union-find, para no depender de Boost.
+namespace
+{
+class Graph
+{
+public:
+    void addVertex()
+    {
+        parent.push_back(int(parent.size()));
+    }
+    void addEdge(int a, int b)
+    {
+        parent[find(a)] = find(b);
+    }
+    int numVertices() const
+    {
+        return int(parent.size());
+    }
+    // Igual que boost::connected_components: numera las componentes desde 0
+    // en orden de aparición y devuelve cuántas hay.
+    int connectedComponents(int* component)
+    {
+        std::vector<int> label(parent.size(), -1);
+        int count = 0;
+        for (int v = 0; v < numVertices(); ++v) {
+            int root = find(v);
+            if (label[root] < 0) {
+                label[root] = count++;
+            }
+            component[v] = label[root];
+        }
+        return count;
+    }
+
+private:
+    int find(int v)
+    {
+        while (parent[v] != v) {
+            parent[v] = parent[parent[v]];
+            v = parent[v];
+        }
+        return v;
+    }
+    std::vector<int> parent;
+};
+}  // namespace
 
