# Plantilla del manifiesto de winget (Fase 19, D6). Se copia a la carpeta manifests/n/NufioCAD/NufioCAD/<versión>/ de un fork
# de https://github.com/microsoft/winget-pkgs con los tres archivos (versión, instalador y local), cambiando <VERSION>,
# <URL> y <SHA256> (el de NufioCAD-<versión>-win64.exe en las notas de la versión). Ver docs/distribucion.md.
PackageIdentifier: NufioCAD.NufioCAD
PackageVersion: <VERSION>
InstallerType: nullsoft
Scope: machine
InstallerSwitches:
  Silent: /S
  SilentWithProgress: /S
Installers:
  - Architecture: x64
    InstallerUrl: <URL>
    InstallerSha256: <SHA256>
ManifestType: installer
ManifestVersion: 1.6.0
